# VisualEngineer local-development example.
# These values are safe local placeholders, not production configuration.

# Required for standalone local database/API commands. Docker Compose supplies
# the same isolated local defaults when these variables are unset.
DATABASE_URL=postgresql+psycopg://visualengineer:visualengineer-local@localhost:5432/visualengineer
TEST_DATABASE_URL=postgresql+psycopg://visualengineer:visualengineer-test-local@localhost:55433/visualengineer_test
POSTGRES_USER=visualengineer
POSTGRES_PASSWORD=visualengineer-local
POSTGRES_DB=visualengineer

# Optional published ports and browser/API origins.
POSTGRES_PUBLISHED_PORT=5432
TEST_POSTGRES_PUBLISHED_PORT=55433
API_HOST=0.0.0.0
API_PORT=8000
API_PUBLISHED_PORT=8000
WEB_PUBLISHED_PORT=3000
WEB_ORIGIN=http://localhost:3000,http://127.0.0.1:3000
NEXT_PUBLIC_API_BASE_URL=http://localhost:8000
LOG_LEVEL=INFO

# Optional Level 0 scanner bounds. Mount only an explicitly authorized,
# read-only repository at a path inside this container root.
READ_ONLY_REPOSITORY_ROOTS=/repositories
REPOSITORY_SCAN_MAX_FILES=5000
REPOSITORY_SCAN_MAX_SELECTED_FILES=250
REPOSITORY_SCAN_MAX_FILE_BYTES=262144
REPOSITORY_SCAN_MAX_TOTAL_BYTES=5242880
REPOSITORY_SCAN_TIMEOUT_SECONDS=20
REPOSITORY_DIRTY_PATH_LIMIT=200

# Optional Local Runner metadata and bounds. `make platform-up` generates the
# actual high-entropy bootstrap token in ignored mode-0600 `.env.runner.local`.
# Do not add a token to this example file.
RUNNER_DISPLAY_NAME=Local Docker Runner
RUNNER_SOFTWARE_VERSION=0.5.0
RUNNER_ONLINE_THRESHOLD_SECONDS=8
RUNNER_LEASE_SECONDS=6
RUNNER_JOB_MAX_ATTEMPTS=2
RUNNER_MAX_RESULT_BYTES=8192
RUNNER_ENVELOPE_TTL_SECONDS=300
RUNNER_REAPER_INTERVAL_SECONDS=1

# Real Provider configuration is intentionally absent. The installed
# DeterministicFixtureProvider requires no SDK, network access, API key, or
# billable account. A future real Provider needs a separate security design and
# must use a secret store rather than this file.
