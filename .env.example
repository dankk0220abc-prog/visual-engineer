# Local-only example values. Do not reuse these credentials outside local development.
DATABASE_URL=postgresql+psycopg://visualengineer:visualengineer-local@localhost:5432/visualengineer
TEST_DATABASE_URL=postgresql+psycopg://visualengineer:visualengineer-test-local@localhost:55433/visualengineer_test
POSTGRES_USER=visualengineer
POSTGRES_PASSWORD=visualengineer-local
POSTGRES_DB=visualengineer
POSTGRES_PUBLISHED_PORT=5432
TEST_POSTGRES_PUBLISHED_PORT=55433
API_HOST=0.0.0.0
API_PORT=8000
API_PUBLISHED_PORT=8000
WEB_PUBLISHED_PORT=3000
WEB_ORIGIN=http://localhost:3000,http://127.0.0.1:3000
NEXT_PUBLIC_API_BASE_URL=http://localhost:8000
LOG_LEVEL=INFO
# Colon-separated exact roots that the Level 0 scanner may inspect.
READ_ONLY_REPOSITORY_ROOTS=/repositories
REPOSITORY_SCAN_MAX_FILES=5000
REPOSITORY_SCAN_MAX_SELECTED_FILES=250
REPOSITORY_SCAN_MAX_FILE_BYTES=262144
REPOSITORY_SCAN_MAX_TOTAL_BYTES=5242880
REPOSITORY_SCAN_TIMEOUT_SECONDS=20
REPOSITORY_DIRTY_PATH_LIMIT=200
